# Included from ~/.gitconfig by install.sh (include.path).
# The personal ~/.gitconfig stays out of this public repository.

[core]
	pager = delta

[interactive]
	diffFilter = delta --color-only

[delta]
	navigate = true
	line-numbers = true
	hyperlinks = true
	hyperlinks-file-link-format = "vscode://file/{path}:{line}"

[merge]
	conflictStyle = zdiff3
